SHOPENSEMBLE_DATA_ROOT=data
SHOPENSEMBLE_DATABASE_URL=postgresql+asyncpg://shopensemble:shopensemble@localhost:5432/shopensemble
SHOPENSEMBLE_BATCH_SIZE=500
SHOPENSEMBLE_MAX_INVALID_ROWS=0
SHOPENSEMBLE_REPORT_ROOT=reports
SHOPENSEMBLE_QUARANTINE_ROOT=quarantine

# Used by app/agents/ (coordinator + review-summarization agent, via PydanticAI)
OPENAI_API_KEY=

# Used by app/api/ (Phase 4b — backend hardening). Both optional; shown here
# with their defaults.
SHOPENSEMBLE_RATE_LIMIT_PER_MINUTE=20
SHOPENSEMBLE_CACHE_TTL_SECONDS=300
